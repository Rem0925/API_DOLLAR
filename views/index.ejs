<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>API Dólar - Explorer</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <style>
        :root {
            --bg-main: #f8fafc;
            --sidebar-bg: #ffffff;
            --border-color: #e2e8f0;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --accent: #0ea5e9;
            --code-bg: #0f172a;
        }
        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-main);
            color: var(--text-main);
            margin: 0;
            height: 100vh;
            display: flex;
            overflow: hidden;
        }
        .sidebar {
            width: 300px;
            background: var(--sidebar-bg);
            border-right: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
            z-index: 10;
        }
        .sidebar-header {
            padding: 1.5rem;
            border-bottom: 1px solid var(--border-color);
        }
        .nav-list {
            padding: 1rem 0;
            overflow-y: auto;
            flex: 1;
        }
        .nav-group-title {
            padding: 0 1.5rem;
            font-size: 0.75rem;
            text-transform: uppercase;
            font-weight: 700;
            color: #94a3b8;
            margin-bottom: 0.5rem;
            margin-top: 1rem;
            letter-spacing: 0.05em;
        }
        .nav-group-title:first-child { margin-top: 0; }
        .nav-item {
            padding: 0.6rem 1.5rem;
            cursor: pointer;
            color: var(--text-muted);
            font-size: 0.9rem;
            font-weight: 500;
            border-left: 3px solid transparent;
            transition: all 0.15s;
            display: flex;
            align-items: center;
        }
        .nav-item:hover {
            background-color: #f1f5f9;
            color: var(--text-main);
        }
        .nav-item.active {
            color: var(--accent);
            border-left-color: var(--accent);
            background-color: #f0f9ff;
        }
        .method-badge {
            font-size: 0.65rem;
            font-weight: 700;
            padding: 2px 5px;
            border-radius: 4px;
            margin-right: 10px;
            font-family: 'JetBrains Mono', monospace;
        }
        .method-get { background: #e0f2fe; color: #0284c7; }
        
        .main-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
        }
        .content-container {
            max-width: 1000px;
            width: 100%;
            margin: 0 auto;
            padding: 2rem 3rem;
        }
        
        h2.endpoint-title { font-weight: 700; font-size: 1.5rem; margin-bottom: 0.5rem; }
        p.endpoint-desc { color: var(--text-muted); margin-bottom: 2rem; }
        
        .url-bar {
            display: flex;
            align-items: center;
            background: white;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 0.4rem 0.4rem 0.4rem 1rem;
            box-shadow: 0 1px 2px rgba(0,0,0,0.05);
            margin-bottom: 1.5rem;
        }
        .url-text {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.9rem;
            flex: 1;
            color: var(--text-muted);
            white-space: nowrap;
            overflow-x: auto;
        }
        .url-text span { color: var(--text-main); font-weight: 600; }
        .btn-send {
            background: var(--text-main);
            color: white;
            border: none;
            padding: 0.5rem 1.25rem;
            border-radius: 6px;
            font-weight: 600;
            font-size: 0.85rem;
            transition: background 0.2s;
        }
        .btn-send:hover { background: #334155; }
        
        .params-section {
            background: white;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            display: none; /* Se oculta si no hay params */
        }
        .params-section h6 {
            font-size: 0.8rem;
            text-transform: uppercase;
            font-weight: 700;
            color: var(--text-muted);
            margin-bottom: 1rem;
        }
        
        .response-container {
            background: var(--code-bg);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
            display: flex;
            flex-direction: column;
            border: 1px solid #1e293b;
        }
        .response-header {
            background: #1e293b;
            padding: 0.75rem 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #334155;
            font-size: 0.8rem;
        }
        .status-wrapper {
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        .status-badge {
            font-weight: 600;
            color: #10b981;
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .status-badge .dot {
            width: 8px; height: 8px; background: #10b981; border-radius: 50%;
        }
        .time-badge { color: #94a3b8; font-family: 'JetBrains Mono', monospace; }
        
        pre {
            margin: 0;
            padding: 1.5rem;
            color: #e2e8f0;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.85rem;
            overflow-x: auto;
            max-height: 500px;
        }
        
        /* Syntax Highlighting */
        .string { color: #7dd3fc; }
        .number { color: #fde047; }
        .boolean { color: #fca5a5; }
        .null { color: #94a3b8; font-style: italic; }
        .key { color: #a7f3d0; }
        
        /* Form Inputs */
        .form-control, .form-select {
            font-size: 0.9rem;
            border-color: var(--border-color);
        }
        .form-control:focus, .form-select:focus {
            box-shadow: none;
            border-color: var(--accent);
        }
    </style>
</head>
<body>

    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-header">
            <h5 class="fw-bold mb-0">API Dólar <span class="badge bg-primary ms-2" style="font-size:0.6rem; vertical-align: middle;">v1.0</span></h5>
            <div class="text-muted small mt-1">Documentación y Depurador</div>
        </div>
        <div class="nav-list" id="nav-list">
            <div class="nav-group-title">Tasas Generales</div>
            <div class="nav-item active" data-id="actual">
                <span class="method-badge method-get">GET</span> Tasa Actual
            </div>
            <div class="nav-item" data-id="proximo">
                <span class="method-badge method-get">GET</span> Tasa Próxima (Futura)
            </div>
            
            <div class="nav-group-title">Histórico</div>
            <div class="nav-item" data-id="historial">
                <span class="method-badge method-get">GET</span> Gráfica de Historial
            </div>
            <div class="nav-item" data-id="fecha">
                <span class="method-badge method-get">GET</span> Búsqueda por Fecha
            </div>
            <div class="nav-item" data-id="calendario">
                <span class="method-badge method-get">GET</span> Días del Mes (Calendario)
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <div class="content-container">
            <h2 class="endpoint-title" id="ui-title">Tasa Actual</h2>
            <p class="endpoint-desc" id="ui-desc">Retorna la tasa de cambio vigente del día actual.</p>
            
            <div class="url-bar">
                <div class="url-text">
                    <span id="ui-method">GET</span> /api/dolar/<span id="ui-path">ves</span>
                </div>
                <button class="btn-send" onclick="sendRequest()" id="btn-send">
                    <i class="bi bi-play-fill"></i> Ejecutar
                </button>
            </div>
            
            <!-- Parámetros dinámicos -->
            <div class="params-section" id="params-section">
                <h6>Query Parameters</h6>
                <div id="params-container" class="row g-3">
                    <!-- Injected via JS -->
                </div>
            </div>
            
            <!-- Response -->
            <div class="response-container">
                <div class="response-header">
                    <div class="text-white fw-bold">Response Body</div>
                    <div class="status-wrapper">
                        <div class="status-badge" id="res-status" style="display:none;"><div class="dot"></div> 200 OK</div>
                        <div class="time-badge" id="res-time">-- ms</div>
                    </div>
                </div>
                <pre><code id="json-debugger">Cargando...</code></pre>
            </div>
        </div>
    </div>

    <!-- Data inicial inyectada desde el backend -->
    <script>
        const initialData = <%- JSON.stringify(precios || {}) %>;
    </script>

    <script>
        // Configuración de endpoints
        const endpoints = {
            'actual': {
                title: 'Tasa Actual',
                desc: 'Retorna la tasa de cambio vigente del día actual (BCV, Binance, Euro, COP).',
                path: 'ves',
                params: []
            },
            'proximo': {
                title: 'Tasa Próxima (Futura)',
                desc: 'Retorna la tasa de cambio estipulada para el próximo día hábil (Ej. Lunes cuando es fin de semana).',
                path: 'ves',
                params: [
                    { name: 'proximo', type: 'hidden', value: 'true' }
                ]
            },
            'historial': {
                title: 'Gráfica de Historial',
                desc: 'Retorna un arreglo con las tasas de los últimos 30 días, ideal para graficar.',
                path: 'historial',
                params: []
            },
            'fecha': {
                title: 'Búsqueda por Fecha',
                desc: 'Busca la tasa de cambio exacta de un día específico en el pasado.',
                path: 'ves',
                params: [
                    { name: 'fecha', type: 'date', label: 'Fecha (YYYY-MM-DD)' }
                ]
            },
            'calendario': {
                title: 'Días del Mes (Calendario)',
                desc: 'Retorna un listado de los días numéricos que contienen registros en la base de datos para un mes y año específico.',
                path: 'ves',
                params: [
                    { name: 'modo', type: 'hidden', value: 'calendario' },
                    { name: 'mes', type: 'number', label: 'Mes (0-11)', min: 0, max: 11, default: new Date().getMonth() },
                    { name: 'anio', type: 'number', label: 'Año (YYYY)', default: new Date().getFullYear() }
                ]
            }
        };

        let currentId = 'actual';

        // Sintaxis Highlighter para JSON
        function syntaxHighlight(json) {
            if (typeof json != 'string') {
                json = JSON.stringify(json, undefined, 2);
            }
            json = json.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
            return json.replace(/("(\\u[a-zA-Z0-9]{4}|\\[^u]|[^\\"])*"(\s*:)?|\b(true|false|null)\b|-?\d+(?:\.\d*)?(?:[eE][+\-]?\d+)?)/g, function (match) {
                let cls = 'number';
                if (/^"/.test(match)) {
                    if (/:$/.test(match)) {
                        cls = 'key';
                        // Remove comillas a las keys para que se vea más limpio
                        match = match.replace(/"/g, ''); 
                    } else {
                        cls = 'string';
                    }
                } else if (/true|false/.test(match)) {
                    cls = 'boolean';
                } else if (/null/.test(match)) {
                    cls = 'null';
                }
                return '<span class="' + cls + '">' + match + '</span>';
            });
        }

        function renderJson(data, ms = null) {
            const code = document.getElementById('json-debugger');
            code.innerHTML = syntaxHighlight(data);
            
            document.getElementById('res-status').style.display = 'flex';
            if(ms !== null) {
                document.getElementById('res-time').innerText = ms + ' ms';
            }
        }

        // Carga Inicial
        renderJson(initialData, 12);

        // UI Logic
        const navItems = document.querySelectorAll('.nav-item');
        
        navItems.forEach(item => {
            item.addEventListener('click', () => {
                // Update active state
                document.querySelector('.nav-item.active').classList.remove('active');
                item.classList.add('active');
                
                const id = item.getAttribute('data-id');
                currentId = id;
                loadEndpointUi(id);
            });
        });

        function loadEndpointUi(id) {
            const conf = endpoints[id];
            
            document.getElementById('ui-title').innerText = conf.title;
            document.getElementById('ui-desc').innerText = conf.desc;
            
            updateUrlPreview();
            
            const paramsContainer = document.getElementById('params-container');
            const paramsSection = document.getElementById('params-section');
            paramsContainer.innerHTML = '';
            
            if (conf.params.length > 0) {
                let hasVisibleParams = false;
                conf.params.forEach(p => {
                    if (p.type === 'hidden') return;
                    hasVisibleParams = true;
                    
                    const div = document.createElement('div');
                    div.className = 'col-md-4';
                    
                    let inputHtml = '';
                    if (p.type === 'date') {
                        // Fecha actual por defecto
                        const today = new Date().toISOString().split('T')[0];
                        inputHtml = `<input type="date" class="form-control dyn-param" id="param-${p.name}" data-name="${p.name}" value="${today}" onchange="updateUrlPreview()">`;
                    } else if (p.type === 'number') {
                        inputHtml = `<input type="number" class="form-control dyn-param" id="param-${p.name}" data-name="${p.name}" value="${p.default}" min="${p.min||''}" max="${p.max||''}" onchange="updateUrlPreview()">`;
                    }
                    
                    div.innerHTML = `
                        <label class="form-label text-muted small fw-bold mb-1">${p.label}</label>
                        ${inputHtml}
                    `;
                    paramsContainer.appendChild(div);
                });
                
                paramsSection.style.display = hasVisibleParams ? 'block' : 'none';
            } else {
                paramsSection.style.display = 'none';
            }
            
            // Auto ejecutar si no requiere inputs del usuario
            const visibleParams = conf.params.filter(p => p.type !== 'hidden');
            if (visibleParams.length === 0) {
                sendRequest();
            } else {
                document.getElementById('json-debugger').innerHTML = '<span class="text-muted">/* Presiona "Ejecutar" para ver la respuesta con estos parámetros */</span>';
                document.getElementById('res-status').style.display = 'none';
                document.getElementById('res-time').innerText = '-- ms';
            }
        }

        function getBuiltUrl() {
            const conf = endpoints[currentId];
            let url = `/api/dolar/${conf.path}`;
            const queryParts = [];
            
            conf.params.forEach(p => {
                if (p.type === 'hidden') {
                    queryParts.push(`${p.name}=${p.value}`);
                } else {
                    const el = document.getElementById(`param-${p.name}`);
                    if (el && el.value) {
                        queryParts.push(`${p.name}=${el.value}`);
                    }
                }
            });
            
            if (queryParts.length > 0) {
                url += '?' + queryParts.join('&');
            }
            
            return url;
        }

        function updateUrlPreview() {
            const conf = endpoints[currentId];
            let url = `ves`; // base
            if(conf.path === 'historial') url = 'historial';
            
            const queryParts = [];
            conf.params.forEach(p => {
                if (p.type === 'hidden') {
                    queryParts.push(`${p.name}=<span class="text-primary">${p.value}</span>`);
                } else {
                    const el = document.getElementById(`param-${p.name}`);
                    if (el && el.value) {
                        queryParts.push(`${p.name}=<span class="text-primary">${el.value}</span>`);
                    }
                }
            });
            
            let finalHtml = url;
            if (queryParts.length > 0) {
                finalHtml += '?' + queryParts.join('&amp;');
            }
            document.getElementById('ui-path').innerHTML = finalHtml;
        }

        async function sendRequest() {
            const url = getBuiltUrl();
            const btn = document.getElementById('btn-send');
            const code = document.getElementById('json-debugger');
            
            btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>';
            btn.disabled = true;
            code.innerHTML = '<span class="text-muted">Cargando...</span>';
            
            const startTime = performance.now();
            
            try {
                const response = await fetch(url);
                const data = await response.json();
                const endTime = performance.now();
                const duration = Math.round(endTime - startTime);
                
                renderJson(data, duration);
                
                if (!response.ok) {
                    document.getElementById('res-status').innerHTML = `<div class="dot" style="background:#ef4444"></div> ${response.status} Error`;
                    document.getElementById('res-status').style.color = '#ef4444';
                } else {
                    document.getElementById('res-status').innerHTML = `<div class="dot"></div> ${response.status} OK`;
                    document.getElementById('res-status').style.color = '#10b981';
                }
                
            } catch (error) {
                renderJson({ error: error.message });
                document.getElementById('res-status').innerHTML = `<div class="dot" style="background:#ef4444"></div> Failed`;
                document.getElementById('res-status').style.color = '#ef4444';
            } finally {
                btn.innerHTML = '<i class="bi bi-play-fill"></i> Ejecutar';
                btn.disabled = false;
            }
        }
    </script>
</body>
</html>